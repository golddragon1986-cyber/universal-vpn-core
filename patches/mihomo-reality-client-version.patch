diff --git a/adapter/outbound/reality_compat_test.go b/adapter/outbound/reality_compat_test.go
new file mode 100644
index 0000000..551ab20
--- /dev/null
+++ b/adapter/outbound/reality_compat_test.go
@@ -0,0 +1,36 @@
+package outbound
+
+import (
+	"crypto/ecdh"
+	"crypto/rand"
+	"encoding/base64"
+	"testing"
+)
+
+func TestRealityClientVersion(t *testing.T) {
+	private, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	public := base64.RawURLEncoding.EncodeToString(private.PublicKey().Bytes())
+	for _, tc := range []struct {
+		value string
+		want  [3]byte
+	}{
+		{"", [3]byte{1, 8, 2}},
+		{"26.11.9", [3]byte{26, 11, 9}},
+	} {
+		config, err := (RealityOptions{PublicKey: public, ClientVersion: tc.value}).Parse()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if config.ClientVersion != tc.want {
+			t.Errorf("version %q: got %v, want %v", tc.value, config.ClientVersion, tc.want)
+		}
+	}
+	for _, value := range []string{"26.11", "26.11.256", "a.b.c"} {
+		if _, err := (RealityOptions{PublicKey: public, ClientVersion: value}).Parse(); err == nil {
+			t.Errorf("version %q should be rejected", value)
+		}
+	}
+}
